# Secret da impostare in DigitalOcean → Apps → ideadiluce-pwa → Settings → Environment
# NON committare valori reali. Copia questo elenco nella UI o usa doctl apps update.
#
# Scope consigliato:
#   api RUN_TIME     → segreti server
#   shop BUILD_TIME  → chiavi pubbliche Stripe (prefisso pk_)
#   admin BUILD_TIME → (nessun secret obbligatorio; VITE_API_URL è nello spec)

# ——— Componente: api ———
# Cluster `db-ideadiluce-pwa` (PG 18). Pool PgBouncer `ideadiluce-api` (25061) + diretto defaultdb (25060).
# DATABASE_URL=postgresql://doadmin:...@db-ideadiluce-pwa-....db.ondigitalocean.com:25061/ideadiluce-api?sslmode=require&pgbouncer=true&connection_limit=5
# DIRECT_URL=postgresql://doadmin:...@db-ideadiluce-pwa-....db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=
DIRECT_URL=

ODOO_CATALOG_API_KEY=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_CREDENTIALS_KEY=

# Solo primo deploy / rotazione admin BO (poi rimuovere da BUILD se non serve re-seed)
ADMIN_SEED_EMAIL=admin@ideadiluce.it
ADMIN_SEED_PASSWORD=

# Listini Odoo (product.pricelist id) — se segmentazione B2C/B2B/Professional
# ODOO_PRICELIST_B2C_ID=
# ODOO_PRICELIST_B2B_ID=
# ODOO_PRICELIST_PROFESSIONAL_ID=

# Email: in produzione partono da Odoo. SMTP è fallback se Odoo mail è irraggiungibile.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_ENABLED=true
# PAID_SYNC_ALERT_EMAIL=
# ODOO_CHECKOUT_REQUIRE_LIVE=false
# ODOO_EMERGENCY_MODE=false

# Bonifico bancario (checkout)
# BANK_TRANSFER_HOLDER=
# BANK_TRANSFER_IBAN=
# BANK_TRANSFER_BANK_NAME=

# Opzionali — abilita quando servono
# DEEPL_API_KEY=
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# DHL_API_KEY=
# DHL_API_SECRET=
# FEDEX_CLIENT_ID=
# FEDEX_CLIENT_SECRET=
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BUCKET=
# SPACES_CDN_URL=
# UPTIMEROBOT_API_KEY=

# ——— Componente: shop (BUILD_TIME) ———
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Opzionale lato server (fallback runtime via GET /api/v1/payments/stripe/config)
STRIPE_PUBLISHABLE_KEY=
